{
    "name":  "shortcut",
    "productName":  "ShortCut",
    "version":  "2.4.6",
    "description":  "Desktop quick panel for shortcuts",
    "main":  "dist-electron/main.js",
    "scripts":  {
                    "dev":  "vite",
                    "build":  "tsc \u0026\u0026 vite build",
                    "preview":  "vite preview",
                    "hardware:build":  "powershell -ExecutionPolicy Bypass -File scripts/build-hardware-monitor.ps1",
                    "music:bridge":  "powershell -ExecutionPolicy Bypass -File scripts/build-music-bridge.ps1",
                    "media:validate":  "powershell -NoProfile -ExecutionPolicy Bypass -File tools/media-validate.ps1",
                    "notification:validate":  "powershell -NoProfile -ExecutionPolicy Bypass -File tools/notification-validate.ps1"
                },
    "keywords":  [
                     "electron",
                     "shortcut",
                     "panel"
                 ],
    "author":  "wanan",
    "license":  "MIT",
    "type":  "commonjs",
    "devDependencies":  {
                            "@tailwindcss/oxide-win32-x64-msvc":  "^4.3.1",
                            "@tailwindcss/vite":  "^4.3.1",
                            "@tauri-apps/cli":  "^2.12.0",
                            "@types/node":  "^26.0.1",
                            "@types/qrcode":  "^1.5.6",
                            "@types/react":  "^19.2.17",
                            "@types/react-dom":  "^19.2.3",
                            "@types/uuid":  "^10.0.0",
                            "@vitejs/plugin-react":  "^6.0.3",
                            "autoprefixer":  "^10.5.2",
                            "postcss":  "^8.5.15",
                            "tailwindcss":  "^4.3.1",
                            "typescript":  "^6.0.3",
                            "vite":  "^8.1.0"
                        },
    "dependencies":  {
                         "@dnd-kit/core":  "^6.3.1",
                         "@dnd-kit/sortable":  "^10.0.0",
                         "@dnd-kit/utilities":  "^3.2.2",
                         "electron-updater":  "^6.8.9",
                         "framer-motion":  "^12.42.0",
                         "lucide-react":  "^1.21.0",
                         "qrcode":  "^1.5.4",
                         "react":  "^19.2.7",
                         "react-dom":  "^19.2.7",
                         "uuid":  "^14.0.1",
                         "ws":  "^8.21.3",
                         "zustand":  "^5.0.14"
                     }
