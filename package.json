{
  "name": "shortcut",
  "productName": "ShortCut",
  "version": "2.0.2",
  "description": "Desktop quick panel for shortcuts",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "release:prepare": "node scripts/prepare-release-notes.mjs",
    "electron:build": "npm run build && tsc -p tsconfig.electron.json && npm run release:prepare && electron-builder --win --publish never",
    "electron:build:dir": "npm run build && tsc -p tsconfig.electron.json && npm run release:prepare && electron-builder --win --dir",
    "release:update": "powershell -ExecutionPolicy Bypass -File scripts/publish-update.ps1"
  },
  "keywords": [
    "electron",
    "shortcut",
    "panel"
  ],
  "author": "wanan",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@tailwindcss/oxide-win32-x64-msvc": "^4.3.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "concurrently": "^10.0.3",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "electron-updater": "^6.8.9",
    "framer-motion": "^12.42.0",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "uuid": "^14.0.1",
    "zustand": "^5.0.14"
  }
}
