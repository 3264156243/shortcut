<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 云端 api.php / file.php / relay-ws -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 局域网一键直连时用于提示"是否同一 Wi-Fi"（可选，缺失不影响功能） -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- 前台服务：电脑控制要在退到后台时保持实时连接（用户要求） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ 必须声明具体类型；connectedDevice 对应"与外部设备保持连接" -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"
        tools:targetApi="34" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      应用内更新：下载新 APK 后需要交给系统安装器。
      Android 8+ 该权限是"每个来源 App 单独授权"，且 **Android 14+ 每次安装都要用户再确认** ——
      所以本权限只让"安装对话框能弹出来"，点确认仍必须用户自己操作。
    -->
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- 上传文件选择（P3 文件快传）；此处先声明，避免后续加功能时改 manifest 权限分组 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
      扫码绑定（对齐 web 的「扫码绑定」）：
      相机用于实时扫描桌面端二维码。
      camera 特性声明为 required=false —— 没有摄像头的设备仍可装，
      走「从相册选二维码图片」或手输绑定码（与 web 的三重兜底一致）。
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <application
        android:name=".ShortcutApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShortCut"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.ShortCut">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          应用内更新的 FileProvider。
          为什么需要：Android 7+ 禁止把 file:// URI 暴露给其它 App
          （会抛 FileUriExposedException），必须用 content:// URI 交给系统安装器。
          authority 必须与 ApkInstaller 里拼的 "${context.packageName}.fileprovider" 一致。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
