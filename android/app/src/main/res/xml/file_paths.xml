<?xml version="1.0" encoding="utf-8"?>
<!--
  应用内更新的 FileProvider 路径声明。

  只暴露**更新专用**的一个子目录，不要把整个 filesDir / 外部存储都暴露出去 ——
  FileProvider 暴露的路径越大，越可能被其它 App 通过构造 URI 读到不该读的文件。

  update_apk 目录与 UpdateViewModel 里下载 APK 的位置对应。
-->
<paths>
    <!-- 应用私有目录下的 updates/（getExternalFilesDir(null)/updates） -->
    <external-files-path
        name="update_apk"
        path="updates/" />

    <!-- 兜底：部分设备外部目录不可用时用内部目录（filesDir/updates） -->
    <files-path
        name="update_apk_internal"
        path="updates/" />
</paths>
