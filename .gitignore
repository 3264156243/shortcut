# ===== 安卓端（android/，原生 Kotlin，2026-10-10 起）=====
# 构建产物与缓存
android/.gradle/
android/build/
android/**/build/
android/.cxx/
android/captures/
android/local.properties
android/.idea/
*.hprof
*.apk
*.aab
*.ap_
*.dex

# 🔴 签名材料：绝不入库（keystore 泄露 = 签名密钥泄露，别人可签发假冒更新包）
*.keystore
*.jks
keystore.properties
signing.properties

# Gradle wrapper 必须入库（换机器/CI 靠它对齐 Gradle 版本），所以显式放行
!android/gradle/wrapper/gradle-wrapper.jar
!android/gradle/wrapper/gradle-wrapper.properties

# ===== 参考项目（docs/references）=====
# 只入库「索引 + 阅读笔记」；克隆的外部源码各自是独立仓库，不入库
# （原先它们是"没有 .gitmodules 的残缺子模块"，clone 拉不到、还总让 git status 脏）
docs/references/*/
!docs/references/notes/
docs/references/**/.git/

# 发布过程中的临时产物（含签名，用完即弃）
docs/server/_latest-*.pending.json

# 官网预览构建产物（scripts/build-site-preview.mjs 生成）
website/_preview*.html

# 官网生成器的输入片段（正文片段是源文件，需入库）
