{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ShortCut",
  "version": "2.4.6",
  "identifier": "com.wanan.shortcut",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ0OEI2NkNDQTk1NkM5MDYKUldRR3lWYXB6R2FMMUJpTUdHWXlzZlJTY2VlNVVkYmVjaFpDQ0QyYjNUYncxd3ZLcG5jb0JBVlQK",
      "endpoints": ["https://shortcut.326415.xyz/updates/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": ["../resources/sj/*",
      "../resources/scripts/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
