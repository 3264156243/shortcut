{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ShortCut",
  "version": "2.4.5",
  "identifier": "com.wanan.shortcut",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/icon.ico",
      "iconAsTemplate": false,
      "tooltip": "ShortCut"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlDREI2OUVGRjhBRUE1OTIKUldTU3BhNzQ3Mm5ibkx2a0htNWtTazFWK0VFRVZ5cVdIcERTMGc5M2ROMlNIN1FQQkVhYmhsNEsK",
      "endpoints": ["https://shortcut.326415.xyz/updates/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": ["../resources/sj/*",
      "../resources/scripts/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
